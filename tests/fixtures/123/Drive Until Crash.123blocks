{"mode":"Blocks","hardwareTarget":"brain","workspace":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"U`9aA+=)r+L1tzA.)-qi\">myVariable</variable></variables><comment id=\"54JghjiW?@fJZ(!A,eB1\" x=\"567\" y=\"95\" h=\"240\" w=\"335\">Project: Drive Until Crash \n\nDescription: The 123 Robot will drive forward until it detects a crash. Then, the 123 Robot will drive in reverse for one step and act crazy.</comment><block type=\"123_events_when_started\" id=\".NsXwU_L.OuU1l7Sho$F\" deletable=\"false\" x=\"70\" y=\"110\"><next><block type=\"123_drivetrain_drive\" id=\"9-Yl+}JI0UWjp-O3UFmX\"><field name=\"DIRECTION\">fwd</field><next><block type=\"123_other_comment\" id=\"S=:cEV{8@+r]0ih617hL\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"d%W/##JZ,mg_6,_5:o;m\"><field name=\"comment\">The 'wait until' block waits for a crash to be detected</field></shadow></value><next><block type=\"123_control_wait_until\" id=\"uxd8AQRnCfWaHoo]+t?~\"><value name=\"CONDITION\"><block type=\"123_sensing_crash\" id=\"q8%A1}m=MSN;9Dj5S~={\"></block></value><next><block type=\"123_drivetrain_drive_for\" id=\"gg;T?BEr53^Sa^Nejx=T\"><field name=\"DIRECTION\">rev</field><field name=\"UNITS\">step</field><value name=\"AMOUNT\"><shadow type=\"math_number\" id=\"rNIjz@]fMb67GL:mWa?b\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"123_act_act\" id=\"x9=G3g:X`7#mS!onyYW4\"><field name=\"ACT\">crazy</field></block></next></block></next></block></next></block></next></block></next></block></xml>","robotConfig":[],"slot":0,"platform":"123","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"downloadLanguage":"python","aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"virtualSkillsYear":"2023","monitorList":{"sensorList":[],"variableList":[],"complexVarList":[]}}