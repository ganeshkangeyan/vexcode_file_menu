{"mode":"Blocks","hardwareTarget":"brain","workspace":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"U`9aA+=)r+L1tzA.)-qi\">myVariable</variable></variables><comment id=\"V=~V-r.N$#(h,Jyl(fZf\" x=\"892\" y=\"-5\" h=\"280\" w=\"304\">Project: Avoiding Obstacles \n\nDescription: This example project has the 123 Robot move until it detects an obstacle (for example, the wall on a VEX 123 field). \n\nWhen the Eye Sensor detects an obstacle, the 123 Robot will stop, drive in reverse, and then turn right. If no obstacle is detected, the 123 Robot will drive forward.</comment><block type=\"123_events_when_started\" id=\".NsXwU_L.OuU1l7Sho$F\" deletable=\"false\" x=\"30\" y=\"30\"><next><block type=\"123_other_comment\" id=\"#sS7c3J#sW`.z)8RS1F^\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"dUN|UtTXNDyZ0]?ieW_t\"><field name=\"comment\">A forever loop allows the Eye Sensor to continuously check for obstacles</field></shadow></value><next><block type=\"123_control_forever\" id=\"+XY4b@CQp4QpXIR.})pM\"><statement name=\"SUBSTACK\"><block type=\"123_other_comment\" id=\"4)KgaCw9suh485Z*s^:U\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"P`y+Az0/{BxWiL-BxcN#\"><field name=\"comment\">If the Eye Sensor detects an obstacle, the blocks in the if branch will run</field></shadow></value><next><block type=\"123_control_if_then_else\" id=\"e@nc2og*2O[f+b3rs#;[\"><value name=\"CONDITION\"><block type=\"123_sensing_near_object\" id=\"bR#vU(Z?VN,)6ZcA{PkU\"></block></value><statement name=\"SUBSTACK\"><block type=\"123_drivetrain_drive_for\" id=\"}A9O_lW=?;MdK1a[qsb[\"><field name=\"DIRECTION\">rev</field><field name=\"UNITS\">step</field><value name=\"AMOUNT\"><shadow type=\"math_number\" id=\"}H8Vo;~D(X}QF8Jp-)us\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"123_drivetrain_turn_for\" id=\"OvvO4X|m}i710:EGxUnF\"><field name=\"TURNDIRECTION\">right</field><value name=\"AMOUNT\"><shadow type=\"math_number\" id=\"l__CJ=bZ2P2qdk`7X%lf\"><field name=\"NUM\">90</field></shadow></value></block></next></block></statement><statement name=\"SUBSTACK2\"><block type=\"123_other_comment\" id=\"}lwV^q7Hg7S?SKUx.!Dt\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"G+e{Fa(YWK~g(3^19}8;\"><field name=\"comment\">If the Eye Sensor does not detect an obstacle, the 123 Robot will drive forward</field></shadow></value><next><block type=\"123_drivetrain_drive\" id=\"C|Zh9Q$r.)QzXSgW%1$t\"><field name=\"DIRECTION\">fwd</field></block></next></block></statement></block></next></block></statement></block></next></block></next></block></xml>","robotConfig":[],"slot":0,"platform":"123","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"downloadLanguage":"python","aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"virtualSkillsYear":"2023","monitorList":{"sensorList":[],"variableList":[],"complexVarList":[]}}