{"mode":"Blocks","hardwareTarget":"brain","workspace":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"U`9aA+=)r+L1tzA.)-qi\">myVariable</variable></variables><comment id=\"wnBO3gW|/!.i3^LokV)p\" x=\"551\" y=\"341\" h=\"233\" w=\"366\">Project: Displaying Colors\n\nDescription: This example project has the VEX 123 Robot display the color that is detected by the Eye Sensor.\n\nIf red is detected, no color is displayed on the 123 Robot.</comment><block type=\"123_events_when_started\" id=\".NsXwU_L.OuU1l7Sho$F\" deletable=\"false\" x=\"70\" y=\"110\"><next><block type=\"123_other_comment\" id=\"_cAH.8fz)-o[*CuL5_XC\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"R`2sHrnUDFn@d)J33%3^\"><field name=\"comment\">Use a forever loop so the Eye Sensor always looks for a color</field></shadow></value><next><block type=\"123_control_forever\" id=\"7rf8]@#@2lQ7b64Dj/q$\"><statement name=\"SUBSTACK\"><block type=\"123_other_comment\" id=\"YX9dSt#`Mt4lZ=-8;`?k\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"(_C1DH$Xr^RNT/c+)D*E\"><field name=\"comment\">The Eye Sensor looks for the color green</field></shadow></value><next><block type=\"123_other_comment\" id=\"}/n]To=I{ahFt@SO~`Ml\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"Nf`3mS;#yJo?#nh1w!;g\"><field name=\"comment\">If green is detected, glow the 123 Robot green</field></shadow></value><next><block type=\"123_control_if_then\" id=\"]9-3ii:82oW)S~Yd1:R/\"><value name=\"CONDITION\"><block type=\"123_sensing_eye_detect\" id=\"dNJ3rv[g/{~tn}NGe;2:\"><field name=\"COLORS\">green</field></block></value><statement name=\"SUBSTACK\"><block type=\"123_looks_glow\" id=\"Ir3f5m{%L(KB`7%Kyls-\"><field name=\"COLOR\">green</field></block></statement><next><block type=\"123_other_comment\" id=\"mGZQ3syPfdj%eeA4`Muq\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\")=mxHY_#Iz1I).b5hs.a\"><field name=\"comment\">The Eye Sensor looks for the color blue</field></shadow></value><next><block type=\"123_other_comment\" id=\"N{GhIX%xNh07-y[AGfLs\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"T8cQ;mpEZu:(xS8-W61V\"><field name=\"comment\">If blue is detected, glow the 123 Robot blue</field></shadow></value><next><block type=\"123_control_if_then\" id=\"7{9{nnBBHCjc,ALoKm??\"><value name=\"CONDITION\"><block type=\"123_sensing_eye_detect\" id=\"2G77alCoqbq`9P2nhj2_\"><field name=\"COLORS\">blue</field></block></value><statement name=\"SUBSTACK\"><block type=\"123_looks_glow\" id=\"v-ed@6/y/H!]npV@_#m]\"><field name=\"COLOR\">blue</field></block></statement><next><block type=\"123_other_comment\" id=\"tq*LY_%}4pXNQV_:Yn1L\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"HZHJRCrz=5j54:fO%}O9\"><field name=\"comment\">The Eye Sensor looks for the color red</field></shadow></value><next><block type=\"123_other_comment\" id=\"xDs@u[sW9(]j7Nj0{#/*\"><value name=\"COMMENT\"><shadow type=\"comment_text\" id=\"AqP)T9o${~YWTUaU(q*]\"><field name=\"comment\">If red is detected, don't display a color on the 123 Robot</field></shadow></value><next><block type=\"123_control_if_then\" id=\"|0MhL|1_4Z_WZLf`c.nW\"><value name=\"CONDITION\"><block type=\"123_sensing_eye_detect\" id=\"~Xn;yr$O~`d6{`!JSx+7\"><field name=\"COLORS\">red</field></block></value><statement name=\"SUBSTACK\"><block type=\"123_looks_glow\" id=\"nD+^=[.+sxdS(TuEy}0b\"><field name=\"COLOR\">off</field></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></xml>","robotConfig":[],"slot":0,"platform":"123","sdkVersion":"20240802.15.00.00","appVersion":"4.67.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"downloadLanguage":"python","aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"virtualSkillsYear":"2023",